<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main dark glass body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8101018"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#20ffffff"/>
        </shape>
    </item>
    <!-- Top red accent stripe -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#30e63946"/>
        </shape>
    </item>
</layer-list>
