<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Terminal Header -->
    <TextView
        android:id="@+id/tv_coach_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forge@coach:~$"
        android:textColor="#E53935"
        android:textSize="14sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_coach_header"
        app:layout_constraintBottom_toTopOf="@id/tv_typing_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tv_typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI is thinking..."
        android:textColor="#555555"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/sv_chips"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Suggestion Chips -->
    <HorizontalScrollView
        android:id="@+id/sv_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ll_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How am I doing?"
                android:textColor="#F5F5F5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motivate me"
                android:textColor="#F5F5F5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What should I focus on?"
                android:textColor="#F5F5F5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyze my week"
                android:textColor="#F5F5F5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/ll_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_coach_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:textColor="#F5F5F5"
            android:textColorHint="#555555"
            android:hint="Ask your AI coach..."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_coach_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_button_primary"
            android:padding="10dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
