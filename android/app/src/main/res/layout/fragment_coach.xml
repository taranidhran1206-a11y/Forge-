<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Coach Header Card -->
    <LinearLayout
        android:id="@+id/coach_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_coach_header"
        android:padding="14dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- AI Avatar -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <View
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_send_button" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚡"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- AI Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORGE AI"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_online" />

                <TextView
                    android:id="@+id/tv_coach_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tactical coach online"
                    android:textColor="@color/fg3"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Clear Chat Button -->
        <ImageView
            android:id="@+id/btn_clear_chat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_clear_chat"
            android:background="@drawable/bg_clear_chat"
            android:padding="8dp"
            android:contentDescription="Clear chat" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/coach_header"
        app:layout_constraintBottom_toTopOf="@id/sv_chips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORGE AI READY"
            android:textColor="@color/fg"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="your tactical performance coach.\nask anything or tap a prompt below."
            android:textColor="@color/fg3"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/coach_header"
        app:layout_constraintBottom_toTopOf="@id/tv_typing_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/tv_typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ai_bubble"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/sv_chips"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_typing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="forge is thinking..."
            android:textColor="@color/fg3"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Suggestion Chips -->
    <HorizontalScrollView
        android:id="@+id/sv_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/input_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Input Bar Card -->
    <LinearLayout
        android:id="@+id/input_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_coach_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_coach_input"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg3"
            android:hint="message forge ai..."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_coach_send"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_send_button"
            android:padding="11dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send"
            app:tint="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
