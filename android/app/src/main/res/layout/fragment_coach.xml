<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:paddingHorizontal="@dimen/page_pad"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/iv_coach_logo"
        android:layout_width="@dimen/logo_size"
        android:layout_height="@dimen/logo_size"
        android:src="@drawable/forge_axe"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_coach_header"
        style="@style/Forge.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Coach"
        app:layout_constraintTop_toTopOf="@id/iv_coach_logo"
        app:layout_constraintBottom_toBottomOf="@id/iv_coach_logo"
        app:layout_constraintStart_toEndOf="@id/iv_coach_logo" />

    <TextView
        android:id="@+id/btn_clear_chat"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tap_min"
        android:minWidth="@dimen/tap_min"
        android:gravity="center"
        android:text="Clear"
        android:textColor="#C4C4C4"
        android:textSize="@dimen/t_small"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/iv_coach_logo"
        app:layout_constraintBottom_toBottomOf="@id/iv_coach_logo"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_coach_key"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tap_min"
        android:minWidth="@dimen/tap_min"
        android:gravity="center"
        android:text="API key"
        android:textColor="#C4C4C4"
        android:textSize="@dimen/t_small"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/iv_coach_logo"
        app:layout_constraintBottom_toBottomOf="@id/iv_coach_logo"
        app:layout_constraintEnd_toStartOf="@id/btn_clear_chat" />

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/iv_coach_logo"
        app:layout_constraintBottom_toTopOf="@id/tv_typing_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/iv_coach_logo"
        app:layout_constraintBottom_toTopOf="@id/tv_typing_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/forge_axe"
            android:contentDescription="@null"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hercules"
            android:textColor="#F5F5F5"
            android:textSize="18sp"
            android:textStyle="bold"

            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your performance coach.\nTap a prompt below or ask anything."
            android:textColor="#555555"
            android:textSize="12sp"

            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tv_typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hercules is thinking…"
        android:textColor="#9E9E9E"
        android:textSize="12sp"

        android:visibility="gone"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/sv_chips"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Suggestion Chips -->
    <HorizontalScrollView
        android:id="@+id/sv_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ll_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/ll_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_coach_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:textColor="#F5F5F5"
            android:textColorHint="#555555"
            android:hint="Ask hercules..."
            android:textSize="14sp"

            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_coach_send"
            android:layout_width="@dimen/tap_min"
            android:layout_height="@dimen/tap_min"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_round_red"
            android:padding="13dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
