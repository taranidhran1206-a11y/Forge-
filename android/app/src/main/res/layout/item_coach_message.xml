<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">

    <!-- AI Message (left-aligned, terminal style) -->
    <LinearLayout
        android:id="@+id/ll_ai_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_ai_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[HERCULES]"
            android:textColor="#E53935"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_ai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <!-- User Message (right-aligned, terminal style) -->
    <LinearLayout
        android:id="@+id/ll_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:maxWidth="300dp"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_pill_red"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />
    </LinearLayout>

</FrameLayout>
