<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">

    <!-- AI Message (left-aligned) -->
    <LinearLayout
        android:id="@+id/ll_ai_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- AI Label Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_ai_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORGE AI"
                android:textColor="@color/red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tv_ai_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg3"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- AI Bubble -->
        <TextView
            android:id="@+id/tv_ai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.35"
            android:background="@drawable/bg_ai_bubble"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />
    </LinearLayout>

    <!-- User Message (right-aligned) -->
    <LinearLayout
        android:id="@+id/ll_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- User Time -->
        <TextView
            android:id="@+id/tv_user_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/fg3"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp" />

        <!-- User Bubble -->
        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:maxWidth="300dp"
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.35"
            android:background="@drawable/bg_user_bubble"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />
    </LinearLayout>

</FrameLayout>
