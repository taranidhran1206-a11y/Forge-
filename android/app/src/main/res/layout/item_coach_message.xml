<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:id="@+id/ll_ai_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:background="@drawable/bg_ai_bubble"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_ai_label"
            style="@style/Forge.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HERCULES"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_ai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5F5F5"
            android:textSize="@dimen/t_body"
            android:lineSpacingMultiplier="1.35" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/t_body"
            android:lineSpacingMultiplier="1.3"
            android:background="@drawable/bg_user_bubble"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp" />
    </LinearLayout>
</FrameLayout>
