<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_pad"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="@dimen/logo_size"
                    android:layout_height="@dimen/logo_size"
                    android:src="@drawable/forge_axe"
                    android:contentDescription="Forge" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Forge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's plan" />
                    <TextView
                        android:id="@+id/tv_date"
                        style="@style/Forge.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monday, Nov 16" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip_neutral"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_flame"
                        android:contentDescription="Day streak" />
                    <TextView
                        android:id="@+id/tv_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="0"
                        android:textColor="#F5F5F5"
                        android:textSize="@dimen/t_body"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_day_dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:id="@+id/day_cell_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="M"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_0"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="W"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="F"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_4"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_5"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/day_cell_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:id="@+id/day_letter_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S"
                        android:textColor="#9E9E9E"
                        android:textSize="@dimen/t_label"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/day_ring_6"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/bg_day_dot"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/card_pad"
                android:layout_marginBottom="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Labors"
                        android:textColor="#F5F5F5"
                        android:textSize="@dimen/t_row"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_labor_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="#4CAF50"
                        android:textSize="@dimen/t_stat"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/pb_labors"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_bar_green" />
                <TextView
                    android:id="@+id/tv_labor_sub"
                    style="@style/Forge.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/pane_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_labors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                    <TextView
                        android:id="@+id/btn_add_labor"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tap_min"
                        android:gravity="center"
                        android:text="Add labor"
                        android:textColor="#F5F5F5"
                        android:textSize="@dimen/t_body"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_neutral"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="22dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pane_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/card_focus_mini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tap_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/card_pad"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Forge.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focus" />
                            <TextView
                                android:id="@+id/tv_mini_state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ready when you are"
                                android:textColor="#F5F5F5"
                                android:textSize="@dimen/t_row"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_mini_time"
                            style="@style/Forge.Num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25:00" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_plan_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tap_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/card_pad"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Forge.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plan" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battle plan and weekly rules"
                                android:textColor="#F5F5F5"
                                android:textSize="@dimen/t_row"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_shield"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/card_pad">
                        <TextView
                            style="@style/Forge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shield wall"
                            android:layout_marginBottom="6dp" />
                        <TextView
                            android:id="@+id/tv_shield_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#F5F5F5"
                            android:textSize="@dimen/t_body"
                            android:lineSpacingMultiplier="1.35" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
