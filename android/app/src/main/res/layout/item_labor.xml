<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Emoji -->
    <TextView
        android:id="@+id/tv_emoji"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="⚔️"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Name -->
    <TextView
        android:id="@+id/tv_labor_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morning Workout"
        android:textColor="#F5F5F5"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_emoji"
        app:layout_constraintEnd_toStartOf="@id/tv_xp_reward" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_labor_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Push-ups, pull-ups, run"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_labor_name"
        app:layout_constraintStart_toEndOf="@id/tv_emoji"
        app:layout_constraintEnd_toStartOf="@id/tv_xp_reward" />

    <!-- Time badge -->
    <TextView
        android:id="@+id/tv_labor_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5:30 AM"
        android:textColor="#9E9E9E"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_labor_desc"
        app:layout_constraintStart_toEndOf="@id/tv_emoji" />

    <!-- XP Reward -->
    <TextView
        android:id="@+id/tv_xp_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+10 XP"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cb_done" />

    <!-- Done checkbox -->
    <CheckBox
        android:id="@+id/cb_done"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:buttonTint="#E53935"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
