<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/labor_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/iv_labor_check"
        android:layout_width="@dimen/check_size"
        android:layout_height="@dimen/check_size"
        android:src="@drawable/ic_check_pending"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_labor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Labor"
            android:textColor="#F5F5F5"
            android:textSize="@dimen/t_row"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_labor_desc"
            style="@style/Forge.Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_labor_focus"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="Focus"
        android:textColor="#FF8A80"
        android:textSize="@dimen/t_small"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_on"
        android:paddingHorizontal="14dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_xp_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+10"
        android:textColor="#4CAF50"
        android:textSize="@dimen/t_small"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_chevron"
        android:contentDescription="@null" />
</LinearLayout>
