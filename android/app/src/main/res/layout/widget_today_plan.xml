<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: only RemoteViews-safe view classes may be used here -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S PLAN"
                android:textColor="#9E9E9E"
                android:textSize="@dimen/t_label"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Today"
                android:textColor="#F5F5F5"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4CAF50"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <LinearLayout
        android:id="@+id/ll_widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/ll_labor_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_labor_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_labor_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_labor_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_labor_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_labor_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp">
            <ImageView
                android:id="@+id/iv_check_6"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_check_pending"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tv_labor_name_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F5F5F5"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_next_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="NEXT"
                android:textColor="#FF9800"
                android:textSize="@dimen/t_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_widget_all_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/widget_check_done"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_all_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All done. Nice work."
                android:textColor="#F5F5F5"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_widget_done_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9E9E9E"
                android:textSize="@dimen/t_small" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Open Forge to set today's labors"
        android:textColor="#9E9E9E"
        android:textSize="@dimen/t_body"
        android:visibility="gone" />
</LinearLayout>
