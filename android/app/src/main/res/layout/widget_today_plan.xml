<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Header row: Title + count badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S PLAN"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.05"/>

            <!-- Date subtitle -->
            <TextView
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wednesday, Oct 28"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Green count badge e.g. "3/4" -->
        <TextView
            android:id="@+id/tv_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Progress bar at TOP -->
    <ProgressBar
        android:id="@+id/pb_widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"/>

    <!-- Labor 1 -->
    <LinearLayout
        android:id="@+id/ll_labor_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Labor 2 -->
    <LinearLayout
        android:id="@+id/ll_labor_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Labor 3 -->
    <LinearLayout
        android:id="@+id/ll_labor_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Labor 4 -->
    <LinearLayout
        android:id="@+id/ll_labor_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_4"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Labor 5 -->
    <LinearLayout
        android:id="@+id/ll_labor_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_5"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Labor 6 -->
    <LinearLayout
        android:id="@+id/ll_labor_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_check_6"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_check_pending"
            android:contentDescription="Status"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_labor_name_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8E8"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- All done message (shown when all complete) -->
    <TextView
        android:id="@+id/tv_widget_all_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All done - nice work"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

</LinearLayout>
