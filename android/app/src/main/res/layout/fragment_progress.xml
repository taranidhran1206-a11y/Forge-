<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Terminal Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="forge@progress:~$"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <!-- Rank Display Card -->
            <LinearLayout
                android:id="@+id/card_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_rank_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚔️"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_rank_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IRON"
                    android:textColor="#78909C"
                    android:textSize="28sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_rank_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level 1"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/pb_rank_xp"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_xp_progress"
                    android:background="@drawable/bg_xp_bar"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_xp_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 XP"
                        android:textColor="#F5F5F5"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_xp_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="200 XP to BRONZE"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_global_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 99% globally"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- WEEKLY STATS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// WEEKLY STATS"
                android:textColor="#555555"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/ll_weekly_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- XP BREAKDOWN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// XP BREAKDOWN"
                android:textColor="#555555"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/ll_xp_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <!-- TIME ALLOCATION (Rize-style) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// TIME ALLOCATION"
                android:textColor="#555555"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/ll_time_allocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Level-up animation overlay -->
    <FrameLayout
        android:id="@+id/fl_level_up_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A0A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_level_up_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔️"
                android:textSize="64sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_level_up_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RANK UP!"
                android:textColor="#E53935"
                android:textSize="32sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_level_up_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRONZE"
                android:textColor="#A1887F"
                android:textSize="24sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
