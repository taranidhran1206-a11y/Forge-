<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/panes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:paddingHorizontal="@dimen/page_pad"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                app:layout_constraintWidth_max="@dimen/content_max_width"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/pane_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Forge.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Rank ladder"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/card_rank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginBottom="14dp">

                        <FrameLayout
                            android:layout_width="@dimen/badge_size"
                            android:layout_height="@dimen/badge_size"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_rank_hex_fill"
                                android:contentDescription="@null" />
                            <ImageView
                                android:id="@+id/iv_rank_hex"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_rank_hex"
                                android:contentDescription="@null" />
                            <ImageView
                                android:id="@+id/iv_rank_axe"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/badge_pad"
                                android:src="@drawable/forge_axe"
                                android:contentDescription="Rank badge" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_rank_level"
                            style="@style/Forge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Level 1" />

                        <TextView
                            android:id="@+id/tv_rank_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IRON"
                            android:textColor="#78909C"
                            android:textSize="@dimen/t_rank"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_card"
                            android:padding="@dimen/card_pad">
                            <TextView
                                style="@style/Forge.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current XP" />
                            <TextView
                                android:id="@+id/tv_xp_current"
                                style="@style/Forge.Num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_card"
                            android:padding="@dimen/card_pad">
                            <TextView
                                style="@style/Forge.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This week" />
                            <TextView
                                android:id="@+id/tv_week_xp"
                                style="@style/Forge.Num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#4CAF50"
                                android:text="+0" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/card_pad"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tv_xp_next"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="200 XP to Bronze"
                                android:textColor="#F5F5F5"
                                android:textSize="@dimen/t_row"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_rank_pct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#C4C4C4"
                                android:textSize="@dimen/t_small"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pb_rank_xp"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/bg_bar_rank" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_rank_ladder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="18dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pane_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Forge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XP breakdown"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/ll_xp_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="@dimen/card_pad"
                        android:paddingVertical="10dp"
                        android:minHeight="48dp"
                        android:layout_marginBottom="18dp" />
                    <TextView
                        style="@style/Forge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last 7 days"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/ll_weekly_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="@dimen/card_pad"
                        android:paddingVertical="10dp"
                        android:minHeight="48dp"
                        android:layout_marginBottom="18dp" />
                    <TextView
                        style="@style/Forge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time today"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/ll_time_allocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="@dimen/card_pad"
                        android:paddingVertical="10dp"
                        android:minHeight="48dp"
                        android:layout_marginBottom="18dp" />
                    <TextView
                        android:id="@+id/tv_account_label"
                        style="@style/Forge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sync across devices"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/card_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="@dimen/card_pad"
                        android:visibility="gone"
                        android:layout_marginBottom="18dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/fl_level_up_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0A0A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/forge_axe"
                android:contentDescription="@null"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_level_up_title"
                style="@style/Forge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rank up"
                android:textColor="#4CAF50"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_level_up_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRONZE"
                android:textColor="#A1887F"
                android:textSize="@dimen/t_rank"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
