<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_pad"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                style="@style/Forge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gym log" />

            <TextView
                android:id="@+id/tv_gym_title"
                style="@style/Forge.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workouts"
                android:layout_marginBottom="16dp" />

            <!-- Shown while no workout is running -->
            <LinearLayout
                android:id="@+id/ll_idle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_start_workout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tap_min"
                    android:gravity="center"
                    android:text="Start workout"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/t_body"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:background="@drawable/bg_card"
                    android:padding="@dimen/card_pad"
                    android:layout_marginBottom="18dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_week_workouts"
                            style="@style/Forge.Num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />
                        <TextView
                            style="@style/Forge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This week" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_week_sets"
                            style="@style/Forge.Num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />
                        <TextView
                            style="@style/Forge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sets" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_last_workout"
                            style="@style/Forge.Num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–" />
                        <TextView
                            style="@style/Forge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last trained" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Forge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best lifts"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:id="@+id/ll_bests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="@dimen/card_pad"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="18dp" />

                <TextView
                    style="@style/Forge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:id="@+id/ll_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Shown during a workout -->
            <LinearLayout
                android:id="@+id/ll_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_next"
                    android:padding="@dimen/card_pad"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_active_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workout"
                            android:textColor="#F5F5F5"
                            android:textSize="@dimen/t_row"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_active_summary"
                            style="@style/Forge.Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 sets" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_active_time"
                        style="@style/Forge.Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_exercises"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_add_exercise"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tap_min"
                    android:gravity="center"
                    android:text="Add exercise"
                    android:textColor="#F5F5F5"
                    android:textSize="@dimen/t_body"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_neutral"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btn_finish_workout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tap_min"
                    android:gravity="center"
                    android:text="Finish workout"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/t_body"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/btn_discard_workout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tap_min"
                    android:gravity="center"
                    android:text="Discard workout"
                    android:textColor="#9E9E9E"
                    android:textSize="@dimen/t_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_gym_credit"
                style="@style/Forge.Sub"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tap_min"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:text="Exercise list: ExerciseDB via openGym, MIT licence" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
