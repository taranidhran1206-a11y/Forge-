<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tv_cat_emoji"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="🧠"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_cat_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Deep Work"
        android:textColor="#F5F5F5"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginStart="8dp" />

    <ProgressBar
        android:id="@+id/pb_cat_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/bg_xp_progress"
        android:background="@drawable/bg_xp_bar"
        android:layout_marginHorizontal="8dp" />

    <TextView
        android:id="@+id/tv_cat_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2h 30m"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:minWidth="48dp"
        android:gravity="end" />

</LinearLayout>
