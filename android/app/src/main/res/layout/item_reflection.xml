<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/card_pad"
    android:layout_marginBottom="8dp">
    <TextView
        android:id="@+id/tv_ref_date"
        style="@style/Forge.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nov 12, 2026"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tv_ref_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What did you fight for today?"
        android:textColor="#9E9E9E"
        android:textSize="@dimen/t_small"
        android:layout_marginBottom="6dp" />
    <TextView
        android:id="@+id/tv_ref_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F5F5F5"
        android:textSize="@dimen/t_body"
        android:lineSpacingMultiplier="1.35"
        android:layout_marginBottom="8dp" />
    <TextView
        android:id="@+id/tv_ref_ai_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#C4C4C4"
        android:textSize="@dimen/t_body"
        android:lineSpacingMultiplier="1.35"
        android:background="@drawable/bg_card_elevated"
        android:padding="12dp"
        android:visibility="gone" />
</LinearLayout>
