<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rank_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="48dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_rank_hex_fill"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/iv_widget_hex"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_rank_hex_small"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/iv_widget_axe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/forge_axe"
                android:contentDescription="Rank badge" />
        </FrameLayout>
        <TextView
            android:id="@+id/tv_widget_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="LEVEL 1"
            android:textColor="#9E9E9E"
            android:textSize="@dimen/t_label"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom">
        <TextView
            android:id="@+id/tv_widget_rank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="IRON"
            android:textColor="#78909C"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_widget_xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 XP"
            android:textColor="#C4C4C4"
            android:textSize="@dimen/t_small"
            android:fontFamily="monospace" />
        <ProgressBar
            android:id="@+id/pb_widget_rank"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_rank_progress" />
        <TextView
            android:id="@+id/tv_widget_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="#9E9E9E"
            android:textSize="@dimen/t_label" />
    </LinearLayout>
</LinearLayout>
