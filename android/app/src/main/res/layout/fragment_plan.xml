<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:paddingHorizontal="@dimen/page_pad"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/Forge.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan" />

    <TextView
        style="@style/Forge.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battle plan"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/card_weekly_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/card_pad"
        android:layout_marginBottom="14dp">
        <TextView
            style="@style/Forge.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly rules"
            android:layout_marginBottom="6dp" />
        <TextView
            android:id="@+id/tv_weekly_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No rules yet. Add one below."
            android:textColor="#C4C4C4"
            android:textSize="@dimen/t_body"
            android:lineSpacingMultiplier="1.35" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_plan_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <EditText
            android:id="@+id/et_plan_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/tap_min"
            android:background="@drawable/bg_input"
            android:textColor="#F5F5F5"
            android:textColorHint="#9E9E9E"
            android:hint="Add a rule or type a command"
            android:textSize="@dimen/t_row"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />
        <ImageView
            android:id="@+id/btn_plan_send"
            android:layout_width="@dimen/tap_min"
            android:layout_height="@dimen/tap_min"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_round_red"
            android:padding="13dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>
