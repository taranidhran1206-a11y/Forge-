<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Terminal Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forge@plan:~$"
        android:textColor="#E53935"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="// BATTLE PLAN"
        android:textColor="#555555"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp" />

    <!-- Weekly Rules Card -->
    <LinearLayout
        android:id="@+id/card_weekly_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_terminal"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[WEEKLY RULES]"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_weekly_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No rules set. Type a command below."
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <!-- Plan Entries -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_plan_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_plan_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:textColor="#F5F5F5"
            android:textColorHint="#555555"
            android:hint="Enter command..."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_plan_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_button_primary"
            android:padding="10dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
