<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Terminal Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forge@reflect:~$"
        android:textColor="#E53935"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <!-- Today's Prompt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_terminal"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[PROMPT]"
            android:textColor="#E53935"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_reflect_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What did you fight for today?"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <!-- Reflection Input -->
    <EditText
        android:id="@+id/et_reflection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="@drawable/bg_input"
        android:textColor="#F5F5F5"
        android:textColorHint="#555555"
        android:hint="Type your reflection..."
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/btn_submit_reflection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUBMIT"
        android:textColor="#F5F5F5"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:paddingVertical="14dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_already_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✓ Reflection logged for today"
        android:textColor="#4CAF50"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Past Entries -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="// PAST ENTRIES"
        android:textColor="#555555"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reflections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
