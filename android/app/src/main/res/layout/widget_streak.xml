<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <ImageView
        android:id="@+id/streak_fire"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_flame"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom">
        <TextView
            android:id="@+id/streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F5F5F5"
            android:textSize="44sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAY STREAK"
            android:textColor="#C4C4C4"
            android:textSize="@dimen/t_label"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/streak_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0 today"
            android:textColor="#9E9E9E"
            android:textSize="@dimen/t_small" />
    </LinearLayout>
</LinearLayout>
